generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum CampaignStatus {
  SCHEDULED
  QUEUED
  COMPLETED
  FAILED
  PARTIAL
}

enum SmtpAccountKind {
  ENV
  CUSTOM
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  passwordHash    String?
  name            String?
  avatarUrl       String?
  googleSubject   String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  emails          Email[]
  campaigns       EmailCampaign[]
  smtpAccounts    SmtpSenderAccount[]
  slackConnection SlackConnection?
}

model EmailSearchOutbox {
  id        String   @id @default(uuid())
  emailId   String   @unique
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model SmtpSenderAccount {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  kind           SmtpAccountKind @default(CUSTOM)
  host           String
  port           Int
  secure         Boolean         @default(false)
  username       String
  passwordCipher String?
  mailFrom       String
  hourlyQuota    Int             @default(100)
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emails         Email[]

  @@unique([userId, label])
  @@index([userId])
}

model SlackConnection {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId                String
  teamName              String?
  channelId             String?
  channelName           String?
  accessTokenCipher     String
  incomingWebhookCipher String?
  scope                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model EmailCampaign {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  startAt        DateTime
  minDelayMs     Int
  hourlyQuota    Int
  status         CampaignStatus @default(SCHEDULED)
  idempotencyKey String?
  recipientCount Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emails         Email[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, createdAt])
}

model Email {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceIndex     Int?
  recipient         String
  subject           String
  body              String
  status            EmailStatus    @default(SCHEDULED)
  scheduledAt       DateTime
  sentAt            DateTime?
  failureReason     String?
  providerMessageId   String?
  smtpSenderAccountId String?
  smtpSenderAccount   SmtpSenderAccount? @relation(fields: [smtpSenderAccountId], references: [id], onDelete: SetNull)
  deferralReason      String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  searchOutbox        EmailSearchOutbox?

  @@index([userId])
  @@index([smtpSenderAccountId])
  @@index([status])
  @@index([scheduledAt])
  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([campaignId, sequenceIndex])
}
