# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://127.0.0.1:5173

# PostgreSQL (Docker Compose service: postgres)
DATABASE_URL=postgresql://outbox:outbox@127.0.0.1:5433/outbox_email_scheduler?schema=public

# Redis (Docker Compose service: redis)
REDIS_URL=redis://127.0.0.1:6380

# JWT — use a long random value in any shared or deployed environment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Ethereal Email (https://ethereal.email) — required by the worker for SMTP delivery
# Generate an account with: npm run ethereal:create
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=
MAIL_FROM=Outbox Scheduler <no-reply@ethereal.email>

# Worker reliability (throughput is enforced in the worker, not the HTTP API)
EMAIL_WORKER_CONCURRENCY=2
EMAIL_RATE_LIMIT_MAX=2
EMAIL_RATE_LIMIT_DURATION_MS=1000
EMAIL_PROCESSING_TIMEOUT_MS=60000

# Encrypts stored SMTP/Slack secrets at rest (defaults to JWT_SECRET if unset)
CREDENTIALS_ENCRYPTION_KEY=

# Default hourly quota for the environment-backed Ethereal sender row
DEFAULT_SENDER_HOURLY_QUOTA=200

# Slack OAuth (create a Slack app in a development workspace)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:3001/api/slack/callback
SLACK_SCOPES=incoming-webhook,chat:write
SLACK_NOTIFY_DEBOUNCE_MS=300000

# Google OAuth (optional — local email/password login remains available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://127.0.0.1:5173/auth/google/callback

# Elasticsearch (optional — search degrades gracefully when disabled or unavailable)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=

# Restrict BullMQ dashboard to specific user emails (comma-separated). Empty = any signed-in user.
QUEUE_DASHBOARD_ADMIN_EMAILS=

# Frontend (Vite only reads VITE_ prefixed variables)
VITE_API_BASE_URL=http://127.0.0.1:3001
